------------------------------------------------------------------
-- วิเคราะห์ไข่
------------------------------------------------------------------
local function analyze(eggName, data)
	local ev, rare, total = 0, 0, 0
	for _, pet in ipairs(data.Pets) do
		total += pet.Chance
		ev += (pet.Chance / 100) * pet.Value
		if pet.Chance <= CONFIG.RareThreshold then
			rare += pet.Chance
		end
	end

	local price = math.max(data.Price or 0, 1)
	local score
	if CONFIG.RankBy == "EV" then
		score = ev
	elseif CONFIG.RankBy == "RareChance" then
		score = rare
	else
		score = ev / price
	end

	-- เรียงของในไข่จากโอกาสมากไปน้อย
	local pets = table.clone(data.Pets)
	table.sort(pets, function(a, b)
		return a.Chance > b.Chance
	end)

	return {
		Name = eggName,
		Price = data.Price or 0,
		EV = ev,
		RareChance = rare,
		Total = total,
		Score = score,
		Pets = pets,
	}
end

local function buildRanking()
	local list = {}
	for eggName, data in pairs(EGG_DATA) do
		table.insert(list, analyze(eggName, data))
	end
	table.sort(list, function(a, b)
		return a.Score > b.Score
	end)
	return list
end

------------------------------------------------------------------
-- วาร์ป
------------------------------------------------------------------
local function teleportToEgg(eggName)
	local folder = workspace:FindFirstChild(CONFIG.EggFolderName)
	local egg = folder and folder:FindFirstChild(eggName)
	local char = player.Character

	if not egg then
		warn("[EggInspector] ไม่พบไข่ใน Workspace." .. CONFIG.EggFolderName .. ": " .. eggName)
		return
	end
	if not char then
		return
	end

	-- GetPivot ใช้ได้ทั้ง Model และ BasePart
	char:PivotTo(egg:GetPivot() * CFrame.new(CONFIG.TeleportOffset))
end

------------------------------------------------------------------
-- UI helpers
------------------------------------------------------------------
local function make(className, props, parent)
	local inst = Instance.new(className)
	for key, value in pairs(props) do
		inst[key] = value
	end
	inst.Parent = parent
	return inst
end

local function rarityColor(chance)
	if chance <= 1 then
		return Color3.fromRGB(255, 200, 60) -- ทอง
	elseif chance <= 5 then
		return Color3.fromRGB(190, 120, 255) -- ม่วง
	elseif chance <= 20 then
		return Color3.fromRGB(90, 160, 255) -- ฟ้า
	end
	return Color3.fromRGB(190, 190, 190) -- เทา
end

local function fmt(n)
	if n >= 1e6 then
		return string.format("%.1fM", n / 1e6)
	elseif n >= 1e3 then
		return string.format("%.1fK", n / 1e3)
	end
	return string.format("%.1f", n)
end

