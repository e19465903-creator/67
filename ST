local function buildRow(rank, info)
	local row = make("Frame", {
		Size = UDim2.new(1, -6, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Color3.fromRGB(42, 42, 52),
		BorderSizePixel = 0,
		LayoutOrder = rank,
	}, scroll)
	make("UICorner", { CornerRadius = UDim.new(0, 8) }, row)
	make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, row)

	-- ไข่ที่ดีที่สุดมีกรอบทอง
	if rank == 1 then
		make("UIStroke", { Color = Color3.fromRGB(255, 200, 60), Thickness = 1.5 }, row)
	end

	-- ส่วนหัว: ชื่อไข่ (กดเพื่อขยาย) + ปุ่มวาร์ป
	local header = make("Frame", {
		Size = UDim2.new(1, 0, 0, 44),
		BackgroundTransparency = 1,
		LayoutOrder = 1,
	}, row)

	local warning = ""
	if math.abs(info.Total - 100) > 0.01 then
		warning = string.format(" | ⚠รวม %.1f%%", info.Total)
	end

	local toggle = make("TextButton", {
		Size = UDim2.new(1, -74, 1, 0),
		BackgroundTransparency = 1,
		Text = string.format(
			"  #%d %s\n  ราคา %s | EV %.1f | หายาก %.1f%%%s",
			rank, info.Name, fmt(info.Price), info.EV, info.RareChance, warning
		),
		TextColor3 = Color3.new(1, 1, 1),
		Font = Enum.Font.Gotham,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, header)

	local tpBtn = make("TextButton", {
		Size = UDim2.fromOffset(64, 30),
		Position = UDim2.new(1, -70, 0, 7),
		BackgroundColor3 = Color3.fromRGB(60, 110, 200),
		Text = "วาร์ป",
		TextColor3 = Color3.new(1, 1, 1),
		Font = Enum.Font.GothamBold,
		TextSize = 13,
	}, header)
	make("UICorner", { CornerRadius = UDim.new(0, 6) }, tpBtn)

	-- ส่วนขยาย: รายการของในไข่
	local body = make("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Visible = false,
		LayoutOrder = 2,
	}, row)
	make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, body)
	make("UIPadding", { PaddingBottom = UDim.new(0, 8) }, body)

	for i, pet in ipairs(info.Pets) do
		make("TextLabel", {
			Size = UDim2.new(1, 0, 0, 18),
			BackgroundTransparency = 1,
			Text = string.format("    %s — %.2f%% (มูลค่า %s)", pet.Name, pet.Chance, fmt(pet.Value)),
			TextColor3 = rarityColor(pet.Chance),
			Font = Enum.Font.Gotham,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left,
			LayoutOrder = i,
		}, body)
	end

	toggle.Activated:Connect(function()
		body.Visible = not body.Visible
	end)
	tpBtn.Activated:Connect(function()
		teleportToEgg(info.Name)
	end)
end

------------------------------------------------------------------
-- รีเฟรช + เชื่อมปุ่ม
------------------------------------------------------------------
local ranking = {}

local function refresh()
	for _, child in ipairs(scroll:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	ranking = buildRanking()
	for rank, info in ipairs(ranking) do
		buildRow(rank, info)
	end
end

local function toggleMenu()
	main.Visible = not main.Visible
end

bestBtn.Activated:Connect(function()
	local best = ranking[1]
	if best then
		teleportToEgg(best.Name)
	end
end)

refreshBtn.Activated:Connect(refresh)
menuBtn.Activated:Connect(toggleMenu)

UserInputService.InputBegan:Connect(function(input, processed)
	if not processed and input.KeyCode == CONFIG.ToggleKey then
		toggleMenu()
	end
end)

refresh()
